# ── Collector ────────────────────────────────────────────────────────────────
# Local SQLite database path (WAL mode).  Relative paths are resolved from the
# collector working directory.
COLLECTOR_DB_PATH=collector_local.db

# How many hours of raw telemetry to retain locally (default: 24).
RAW_RETENTION_HOURS=24

# How often the retention job runs (seconds, default: 3600).
RETENTION_INTERVAL_S=3600

# HMAC secret used to pseudonymise host names and IPs into source_ref.
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit the real value.
HMAC_SECRET=change_me_before_running

# Source timezone for this collector host (IANA name).
SOURCE_TZ=UTC

# ── Simulator input (inputs/sim_stream.py) ───────────────────────────────────
# Base URL of the scenario simulator server (see tools/sim_stream_server.py).
SIM_STREAM_URL=http://localhost:9000
# Poll interval in seconds when using HTTP polling mode.
SIM_POLL_INTERVAL_S=1

# ── Syslog input (inputs/syslog_input.py) ───────────────────────────────────
# Path to auth log file to tail for failed-login events.
# Linux default: /var/log/auth.log  |  macOS: /var/log/secure
SYSLOG_AUTH_LOG=/var/log/auth.log
# How many characters of context to keep (truncated before storage).
SYSLOG_CONTEXT_MAX=512

# ── SaaS endpoint (not used yet – Phase 2) ──────────────────────────────────
SAAS_INGEST_URL=https://saas.example.com/ingest
SAAS_API_KEY=change_me_before_running
SAAS_TIMEOUT_S=10
SAAS_RETRY_MAX=5

# ── Tenant Viewer Tokens (Phase 8 Dashboard & Read APIs) ─────────────────────
# Generate random tokens using python tools/gen_tokens.py (DO NOT COMMIT REAL VALUES)
VIEWER_TOKEN_ACME=replace_with_random_viewer_token_acme
VIEWER_TOKEN_GLOBEX=replace_with_random_viewer_token_globex

